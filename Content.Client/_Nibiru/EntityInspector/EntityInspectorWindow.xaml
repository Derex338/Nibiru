<controls:FancyWindow xmlns="https://spacestation14.io"
                xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                SetSize="820 600"
                MinSize="500 300"
                Resizable="True"
                Title="Инспектор сущности">
    <!-- Главный горизонтальный сплиттер: левая колонка | правая панель деталей -->
    <SplitContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True" Name="MainSplit">

        <!-- ======== ЛЕВАЯ КОЛОНКА: список компонентов + поля ======== -->
        <BoxContainer Orientation="Vertical" MinWidth="280" MaxWidth="400"
                      HorizontalExpand="False" VerticalExpand="True">

            <!-- Заголовок с именем сущности -->
            <PanelContainer Name="EntityHeader" StyleClasses="PanelLow"
                            HorizontalExpand="True" Margin="0 0 0 2">
                <BoxContainer Orientation="Horizontal" Margin="6 4">
                    <Label Name="EntityNameLabel"
                           Text="Сущность"
                           StyleClasses="LabelHeading"
                           HorizontalExpand="True"
                           ClipText="True"/>
                </BoxContainer>
            </PanelContainer>

            <!-- Скролл-контейнер для компонентов -->
            <ScrollContainer Name="ComponentScroll"
                             HScrollEnabled="False"
                             HorizontalExpand="True"
                             VerticalExpand="True">
                <BoxContainer Orientation="Vertical" Name="ComponentList"
                              HorizontalExpand="True"
                              SeparationOverride="1"/>
            </ScrollContainer>
        </BoxContainer>

        <!-- ======== ПРАВАЯ ПАНЕЛЬ: детальная информация о поле ======== -->
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True"
                      MinWidth="200">

            <!-- Заголовок правой панели -->
            <PanelContainer Name="DetailHeader" StyleClasses="PanelLow"
                            HorizontalExpand="True" Margin="2 0 0 2">
                <BoxContainer Orientation="Horizontal" Margin="6 4">
                    <Label Name="DetailTitleLabel"
                           Text="Выберите поле..."
                           StyleClasses="LabelHeading"
                           HorizontalExpand="True"
                           ClipText="True"/>
                </BoxContainer>
            </PanelContainer>

            <!-- Скролл для деталей -->
            <ScrollContainer Name="DetailScroll"
                             HScrollEnabled="False"
                             HorizontalExpand="True"
                             VerticalExpand="True">
                <BoxContainer Orientation="Vertical" Name="DetailContainer"
                              Margin="8 6"
                              HorizontalExpand="True"
                              SeparationOverride="4">
                    <!-- Placeholder -->
                    <BoxContainer Orientation="Vertical" Name="DetailPlaceholder"
                                  HorizontalExpand="True">
                        <Label Text="Нажмите на поле слева, чтобы увидеть подробности."
                               FontColorOverride="#888888"
                               HorizontalAlignment="Center"
                               Margin="0 20 0 0"
                               MaxWidth="220"
                               ClipText="False"/>
                    </BoxContainer>
                </BoxContainer>
            </ScrollContainer>
        </BoxContainer>

    </SplitContainer>
</controls:FancyWindow>
