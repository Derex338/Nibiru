<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:controls="clr-namespace:Robust.Client.UserInterface.Controls;assembly=Robust.Client"
               Title="{Loc 'nibiru-animal-training-title'}"
               MinSize="400 350">
    <BoxContainer Orientation="Vertical" Margin="10">
        
        <!-- Trust Status -->
        <Label Text="{Loc 'nibiru-animal-training-trust'}" FontColorOverride="LightGreen" />
        <ProgressBar Name="TrustBar" MinValue="0" MaxValue="100" Value="0" MinHeight="20" Margin="0 5 0 15">
            <Label Name="TrustLabel" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ProgressBar>

        <!-- Stress Training Status -->
        <BoxContainer Name="StressContainer" Orientation="Vertical" Visible="False">
            <Label Text="{Loc 'nibiru-animal-training-stress'}" FontColorOverride="LightBlue" />
            <ProgressBar Name="StressBar" MinValue="0" MaxValue="100" Value="0" MinHeight="20" Margin="0 5 0 15">
                <Label Name="StressLabel" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ProgressBar>
            <Button Name="TrainStressButton" Text="{Loc 'nibiru-animal-training-train-stress'}" />
        </BoxContainer>

        <Control MinHeight="15" />

        <!-- Commands Section -->
        <BoxContainer Name="CommandsContainer" Orientation="Vertical" Visible="False">
            <Label Text="{Loc 'nibiru-animal-training-commands'}" FontColorOverride="Yellow" />
            <ScrollContainer MinHeight="150">
                <BoxContainer Name="CommandsList" Orientation="Vertical" SeparationOverride="5" />
            </ScrollContainer>
        </BoxContainer>

    </BoxContainer>
</DefaultWindow>
