<DefaultWindow
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Loc 'bird-post-office' }">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
        <Label Text="{Loc 'select-post-office' }" Margin="5" HorizontalAlignment="Center"/>
        <ScrollContainer VerticalExpand="True" MinHeight="200" MinWidth="250">
            <BoxContainer Name="PostsContainer" Orientation="Vertical" Margin="5"/>
        </ScrollContainer>
    </BoxContainer>
</DefaultWindow>
