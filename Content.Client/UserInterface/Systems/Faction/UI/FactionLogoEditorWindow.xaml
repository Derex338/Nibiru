<ui1:FactionLogoEditorWindow
    xmlns="https://spacestation14.io"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:ui1="clr-namespace:Content.Client.UserInterface.Systems.Faction.UI"
    Title="{Loc 'faction-logo-editor-title'}"
    MinSize="900 450"
    Resizable="False">

    <PanelContainer>
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#111112" />
        </PanelContainer.PanelOverride>

        <BoxContainer Orientation="Horizontal" SeparationOverride="15" Margin="15">
            <!-- 16x16 -->
            <BoxContainer Orientation="Vertical" SeparationOverride="10">
                <Label Text="{Loc 'faction-logo-16-label'}" HorizontalAlignment="Center" />
                <PanelContainer>
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#0d0d0f" BorderColor="#222224" BorderThickness="1" />
                    </PanelContainer.PanelOverride>
                    <GridContainer Name="PixelGrid" Access="Public" Columns="16" Margin="4" HSeparationOverride="0" VSeparationOverride="0" />
                </PanelContainer>

                <BoxContainer Orientation="Horizontal" SeparationOverride="10" HorizontalAlignment="Center">
                    <Button Name="EraserButton" Access="Public" Text="{Loc 'faction-logo-eraser'}" ToggleMode="True" MinWidth="80" />
                    <Button Name="ClearButton" Access="Public" Text="{Loc 'faction-logo-clear'}" MinWidth="100" />
                </BoxContainer>
            </BoxContainer>

            <!-- 8x8 -->
            <BoxContainer Orientation="Vertical" SeparationOverride="15" MinWidth="180">
                <BoxContainer Orientation="Vertical" SeparationOverride="10">
                    <Label Text="{Loc 'faction-logo-8-label'}" HorizontalAlignment="Center" />
                    <PanelContainer HorizontalAlignment="Center">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#0d0d0f" BorderColor="#222224" BorderThickness="1" />
                        </PanelContainer.PanelOverride>
                        <GridContainer Name="PixelGrid8x8" Access="Public" Columns="8" Margin="4" HSeparationOverride="0" VSeparationOverride="0" />
                    </PanelContainer>
                    <Button Name="Clear8x8Button" Access="Public" Text="{Loc 'faction-logo-clear-8'}" HorizontalAlignment="Center" MinWidth="100" />
                </BoxContainer>

                <Control VerticalExpand="True" />

                <Button Name="SaveButton" Access="Public" Text="{Loc 'faction-logo-save-all'}" MinHeight="40" StyleClasses="ButtonSquare" />
            </BoxContainer>

            <!-- Palette -->
            <BoxContainer Orientation="Vertical" SeparationOverride="10" HorizontalExpand="True">
                <Label Text="{Loc 'faction-logo-palette'}" HorizontalAlignment="Center" />

                <BoxContainer Orientation="Horizontal" SeparationOverride="15" HorizontalAlignment="Center">
                    <BoxContainer Orientation="Horizontal" SeparationOverride="5">
                        <PanelContainer Name="BrushPreview" MinSize="24 24" VerticalAlignment="Center">
                            <PanelContainer.PanelOverride>
                                <gfx:StyleBoxFlat BackgroundColor="White" BorderColor="#3a3a3c" BorderThickness="1" />
                            </PanelContainer.PanelOverride>
                        </PanelContainer>
                        <Label Text="{Loc 'faction-logo-brush'}" VerticalAlignment="Center" />
                    </BoxContainer>

                    <BoxContainer Orientation="Horizontal" SeparationOverride="5">
                        <PanelContainer Name="BgPreview" MinSize="24 24" VerticalAlignment="Center">
                            <PanelContainer.PanelOverride>
                                <gfx:StyleBoxFlat BackgroundColor="Transparent" BorderColor="#3a3a3c" BorderThickness="1" />
                            </PanelContainer.PanelOverride>
                        </PanelContainer>
                        <Label Text="{Loc 'faction-logo-bg'}" VerticalAlignment="Center" />
                    </BoxContainer>
                </BoxContainer>

                <ColorSelectorSliders Name="ColorSelector" Access="Public" VerticalExpand="True" Margin="0 5 0 5"/>

                <BoxContainer Orientation="Horizontal" SeparationOverride="10" HorizontalAlignment="Center">
                    <Button Name="BgColorButton" Access="Public" Text="{Loc 'faction-logo-bg-color-button'}" MinWidth="100" />
                    <Button Name="BrushColorButton" Access="Public" Text="{Loc 'faction-logo-brush-color-button'}" MinWidth="100" />
                </BoxContainer>
            </BoxContainer>

            <!-- Presets -->
            <BoxContainer Orientation="Vertical" SeparationOverride="10" MinWidth="160">
                <Label Text="{Loc 'faction-logo-presets'}" HorizontalAlignment="Center" />
                <PanelContainer VerticalExpand="True">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#0d0d0f" BorderColor="#222224" BorderThickness="1" />
                    </PanelContainer.PanelOverride>
                    <ScrollContainer VerticalExpand="True" HScrollEnabled="False" Margin="8">
                        <GridContainer Name="PresetGrid" Access="Public" Columns="2" HSeparationOverride="8" VSeparationOverride="8" HorizontalAlignment="Center" />
                    </ScrollContainer>
                </PanelContainer>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</ui1:FactionLogoEditorWindow>


