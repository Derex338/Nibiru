<ui1:FactionMenu
            xmlns="https://spacestation14.io"
            xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
            xmlns:customControls="clr-namespace:Content.Client.Administration.UI.CustomControls"
            xmlns:ui1="clr-namespace:Content.Client.UserInterface.Systems.Faction.UI"
            Title="{Loc 'Окно фракции'}"
            Resizable="False">

    <BoxContainer Name="FactionCreate" Orientation="Vertical" SeparationOverride="10" MinWidth="250" Access="Public" Visible="True">
        <Label Name="CurrentTextLabel" Text="{Loc 'Название фракции'}" />
        <BoxContainer Orientation="Vertical" SeparationOverride="50">
            <LineEdit Name="LabelLineEdit" Access="Public" />
            <Button Name="CreateButton" Access="Public" ToggleMode="false" StyleClasses="ButtonSquare"
                    MinSize="60 50"
                    Text="{Loc 'Создать'}"/>
        </BoxContainer>
    </BoxContainer>

    <BoxContainer Name="FactionLeaderWindow" Orientation="Vertical" SeparationOverride="10" MinWidth="400" Access="Public" Visible="False">
        <RichTextLabel Name="FactionName" Text="{Loc 'Название фракции: '}" Access="Public" />

        <!-- Название фракции -->
        <BoxContainer
            Name="FactionNameChangeContainer"
            Orientation="Horizontal"
            VerticalExpand="True"
            SizeFlagsStretchRatio="2"
            Margin="5">
            <LineEdit Name="FactionNameChange" Access="Public" MinSize="200 20" PlaceHolder="Название фракции"/>
            <Button Name="FactionNameChangeButton" Access="Public" ToggleMode="false" StyleClasses="ButtonSquare"
                    MinSize="30 20"
                    Text="{Loc 'Сменить'}"/>
        </BoxContainer>

        <!-- Описание фракции -->
        <BoxContainer
            Name="FactionDescriptionChangeContainer"
            Orientation="Horizontal"
            VerticalExpand="True"
            SizeFlagsStretchRatio="2"
            Margin="5">
            <LineEdit Name="FactionDescriptionChange" Access="Public" MinSize="200 20" PlaceHolder="Описание фракции"/>
            <Button Name="FactionDescriptionChangeButton" Access="Public" ToggleMode="false" StyleClasses="ButtonSquare"
                    MinSize="30 20"
                    Text="{Loc 'Сменить'}"/>
        </BoxContainer>

        <!-- Цвет фракции -->
        <BoxContainer
            Name="FactionColorChangeContainer"
            Orientation="Horizontal"
            VerticalExpand="True"
            SizeFlagsStretchRatio="2"
            Margin="5">
            <LineEdit Name="FactionColorChange" Access="Public" MinSize="200 20" PlaceHolder="#000000 or blue"/>
            <Button Name="FactionColorChangeButton" Access="Public" ToggleMode="false" StyleClasses="ButtonSquare"
                    MinSize="30 20"
                    Text="{Loc 'Сменить цвет'}"/>
        </BoxContainer>

        <!-- Иконка фракции -->
        <BoxContainer
            Name="FactionIconChangeContainer"
            Orientation="Horizontal"
            VerticalExpand="True"
            SizeFlagsStretchRatio="2"
            Margin="5">
            <LineEdit Name="FactionIconChange" Access="Public" MinSize="200 20" PlaceHolder="JobIconCaptain"/>
            <Button Name="FactionIconChangeButton" Access="Public" ToggleMode="false" StyleClasses="ButtonSquare"
                    MinSize="30 20"
                    Text="{Loc 'Сменить иконку'}"/>
        </BoxContainer>

        <!-- Статус фракции -->
        <BoxContainer
            Name="FactionStatusContainer"
            Orientation="Horizontal"
            VerticalExpand="True"
            SizeFlagsStretchRatio="2"
            Margin="5">
            <Label Text="Статус фракции:" VerticalAlignment="Center" MinSize="100 20"/>
            <OptionButton Name="FactionStatusDropdown" Access="Public" MinSize="100 20"/>
        </BoxContainer>

        <!-- Переключатель набора -->
        <BoxContainer
            Name="RecruitingContainer"
            Orientation="Horizontal"
            VerticalExpand="True"
            SizeFlagsStretchRatio="2"
            Margin="5">
            <CheckBox Name="RecruitingToggle" Access="Public" Text="Открыть набор в фракцию"/>
        </BoxContainer>

        <!-- Список членов -->
        <BoxContainer
                Name="MembersContainer"
                Orientation="Vertical"
                VerticalExpand="True"
                SizeFlagsStretchRatio="2"
                Margin="5"
                Access="Public">
            <Label Text="{Loc 'faction-members'}"
                    HorizontalAlignment="Left"/>
            <customControls:HSeparator StyleClasses="LowDivider"
                    Margin="0 0 0 10"/>
            <PanelContainer VerticalExpand="True">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#00000000"/>
                </PanelContainer.PanelOverride>
                <ScrollContainer
                    HScrollEnabled="False"
                    HorizontalExpand="True"
                    VerticalExpand="True"
                    MinSize="50 250">
                    <BoxContainer
                        Name="MemberContainer"
                        Orientation="Vertical"
                        VerticalExpand="True"
                        Access="Public">
                    </BoxContainer>
                </ScrollContainer>
            </PanelContainer>
        </BoxContainer>

        <!-- Кнопки управления -->
        <GridContainer
            Name="Buttons"
            HorizontalExpand="true"
            Columns="3">
            <Button Name="TransferTitle" Access="Public" ToggleMode="false" StyleClasses="ButtonSquare"
                    MinSize="150 20"
                    Text="{Loc 'Передать титул'}"/>
            <Button Name="Heir" Access="Public" ToggleMode="false" StyleClasses="ButtonSquare"
                    MinSize="150 20"
                    Text="{Loc 'Назначить наследником'}"/>
            <Button Name="Delete" Access="Public" ToggleMode="false" StyleClasses="ButtonSquare"
                    MinSize="150 20"
                    Text="{Loc 'Расформировать фракцию'}"/>
        </GridContainer>
    </BoxContainer>

    <BoxContainer Name="FactionMemberWindow" Orientation="Vertical" SeparationOverride="10" MinWidth="250" Access="Public" Visible="True">
        <RichTextLabel Name="FactionNameMember" Access="Public" Text="{Loc 'Название фракции'}" />
        <Label Name="FactionLeader" Access="Public" Text="{Loc 'Leader'}" />
        <Label Name="FactionRank" Access="Public" Text="{Loc 'Ваш ранг: '}" />
        <BoxContainer Orientation="Vertical" SeparationOverride="50">
            <Button Name="LeaveButton" Access="Public" ToggleMode="false" StyleClasses="ButtonSquare"
                    MinSize="60 50"
                    Text="{Loc 'Выйти из фракции'}"/>
        </BoxContainer>
    </BoxContainer>
</ui1:FactionMenu>
