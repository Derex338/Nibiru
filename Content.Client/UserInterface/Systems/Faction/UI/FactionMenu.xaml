<ui1:FactionMenu
            xmlns="https://spacestation14.io"
            xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
            xmlns:customControls="clr-namespace:Content.Client.Administration.UI.CustomControls"
            xmlns:ui1="clr-namespace:Content.Client.UserInterface.Systems.Faction.UI"
            Title="{Loc 'Окно фракции'}"
            Resizable="False">

    <BoxContainer Name="FactionCreate" Orientation="Vertical" SeparationOverride="10" MinWidth="250" Access="Public" Visible="True">
        <Label Name="CurrentTextLabel" Text="{Loc 'Название фракции'}" />
        <BoxContainer Orientation="Vertical" SeparationOverride="50">
            <LineEdit Name="LabelLineEdit" Access="Public" />
            <Button Name="CreateButton" Access="Public" ToggleMode="false" StyleClasses="ButtonSquare"
                    MinSize="60 50"
                    Text="{Loc 'Создать'}"/>
        </BoxContainer>
    </BoxContainer>

    <BoxContainer Name="FactionLeaderWindow" Orientation="Vertical" SeparationOverride="10" MinWidth="400" Access="Public" Visible="False">
        <BoxContainer Orientation="Horizontal" SeparationOverride="10">
            <ui1:FactionLogoControl Name="FactionLogoLeader" Access="Public" MinSize="48 48" />
            <RichTextLabel Name="FactionName" Text="{Loc 'Название фракции: '}" Access="Public" VerticalAlignment="Center" />
        </BoxContainer>

        <TabContainer Name="LeaderTabs" Access="Public" VerticalExpand="True">
            <BoxContainer Name="SettingsTab" Orientation="Vertical" SeparationOverride="5" Margin="5" VerticalExpand="True">
                <!-- Название фракции -->
                <BoxContainer Name="FactionNameChangeContainer" Orientation="Horizontal" VerticalExpand="False" Margin="5">
                    <LineEdit Name="FactionNameChange" Access="Public" MinSize="200 20" PlaceHolder="Название фракции" HorizontalExpand="True"/>
                    <Button Name="FactionNameChangeButton" Access="Public" ToggleMode="false" StyleClasses="ButtonSquare" MinSize="30 20" Text="{Loc 'Сменить'}"/>
                </BoxContainer>

                <!-- Описание фракции -->
                <BoxContainer Name="FactionDescriptionChangeContainer" Orientation="Horizontal" VerticalExpand="False" Margin="5">
                    <LineEdit Name="FactionDescriptionChange" Access="Public" MinSize="200 20" PlaceHolder="Описание фракции" HorizontalExpand="True"/>
                    <Button Name="FactionDescriptionChangeButton" Access="Public" ToggleMode="false" StyleClasses="ButtonSquare" MinSize="30 20" Text="{Loc 'Сменить'}"/>
                </BoxContainer>

                <!-- Цвет фракции -->
                <BoxContainer Name="FactionColorChangeContainer" Orientation="Horizontal" VerticalExpand="False" Margin="5">
                    <LineEdit Name="FactionColorChange" Access="Public" MinSize="200 20" PlaceHolder="#000000 or blue" HorizontalExpand="True"/>
                    <Button Name="FactionColorChangeButton" Access="Public" ToggleMode="false" StyleClasses="ButtonSquare" MinSize="30 20" Text="{Loc 'Сменить цвет'}"/>
                </BoxContainer>

                <!-- Иконка фракции -->
                <BoxContainer Name="FactionIconChangeContainer" Orientation="Horizontal" VerticalExpand="False" Margin="5">
                    <LineEdit Name="FactionIconChange" Access="Public" MinSize="200 20" PlaceHolder="JobIconCaptain" HorizontalExpand="True"/>
                    <Button Name="FactionIconChangeButton" Access="Public" ToggleMode="false" StyleClasses="ButtonSquare" MinSize="30 20" Text="{Loc 'Сменить иконку'}"/>
                </BoxContainer>

                <!-- Логотип фракции -->
                <Button Name="EditLogoButton" Access="Public" ToggleMode="false" StyleClasses="ButtonSquare" MinSize="150 20" Text="{Loc 'Редактировать логотип'}" Margin="5"/>

                <!-- Переключатель набора -->
                <BoxContainer Name="RecruitingContainer" Orientation="Horizontal" VerticalExpand="False" Margin="5">
                    <CheckBox Name="RecruitingToggle" Access="Public" Text="{Loc 'faction-ui-recruiting-toggle'}"/>
                </BoxContainer>

                <Button Name="Delete" Access="Public" ToggleMode="false" StyleClasses="ButtonSquare" MinSize="150 20" Text="{Loc 'Расформировать фракцию'}" Margin="0 10 0 0"/>
            </BoxContainer>

            <BoxContainer Name="FiltersTab" Orientation="Vertical" SeparationOverride="5" Margin="5" VerticalExpand="True">
                <Label Text="Фильтры вступления:" Margin="0 10 0 0" StyleClasses="LabelBig"/>
                
                <BoxContainer Orientation="Horizontal" Margin="5">
                    <Label Text="Расы:" MinSize="80 0"/>
                    <Button Name="FilterSpeciesButton" Access="Public" Text="Выбрать..." HorizontalExpand="True"/>
                </BoxContainer>
                <Label Name="FilterSpeciesLabel" Access="Public" Text="Все" FontColorOverride="Gray" Margin="85 0 0 0"/>

                <BoxContainer Orientation="Horizontal" Margin="5">
                    <Label Text="Пол:" MinSize="80 0"/>
                    <Button Name="FilterGenderButton" Access="Public" Text="Выбрать..." HorizontalExpand="True"/>
                </BoxContainer>
                <Label Name="FilterGenderLabel" Access="Public" Text="Все" FontColorOverride="Gray" Margin="85 0 0 0"/>

                <BoxContainer Orientation="Horizontal" Margin="5">
                    <Label Text="Цвет кожи:" MinSize="80 0"/>
                    <LineEdit Name="FilterSkinColor" Access="Public" MinSize="200 20" PlaceHolder="#hex, #hex..." HorizontalExpand="True"/>
                    <Button Name="FilterSkinColorButton" Access="Public" Text="Ок"/>
                </BoxContainer>

                <BoxContainer Orientation="Vertical" Margin="5">
                    <Label Text="Слова в имени (через запятую):"/>
                    <BoxContainer Orientation="Horizontal">
                        <LineEdit Name="FilterName" Access="Public" MinSize="200 20" PlaceHolder="Иван, Петро..." HorizontalExpand="True"/>
                        <Button Name="FilterNameButton" Access="Public" Text="Ок"/>
                    </BoxContainer>
                </BoxContainer>
            </BoxContainer>

            <BoxContainer Name="MembersTab" Orientation="Vertical" SeparationOverride="5" Margin="5" VerticalExpand="True">
                <!-- Управление ролями -->
                <Button Name="CreateRoleButton" Access="Public" ToggleMode="false" StyleClasses="ButtonSquare" MinSize="150 20" Text="{Loc 'Управление ролями'}"/>

                <!-- Список членов -->
                <BoxContainer Name="MembersContainer" Orientation="Vertical" VerticalExpand="True" SizeFlagsStretchRatio="2" Margin="5" Access="Public">
                    <Label Text="{Loc 'faction-members'}" HorizontalAlignment="Left"/>
                    <customControls:HSeparator StyleClasses="LowDivider" Margin="0 0 0 10"/>
                    <PanelContainer VerticalExpand="True">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#00000000"/>
                        </PanelContainer.PanelOverride>
                        <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True" MinSize="50 250">
                            <BoxContainer Name="MemberContainer" Orientation="Vertical" VerticalExpand="True" Access="Public">
                            </BoxContainer>
                        </ScrollContainer>
                    </PanelContainer>
                </BoxContainer>

                <!-- Кнопки управления -->
                <GridContainer Name="Buttons" HorizontalExpand="true" Columns="2">
                    <Button Name="TransferTitle" Access="Public" ToggleMode="false" StyleClasses="ButtonSquare" MinSize="150 20" Text="{Loc 'Передать титул'}"/>
                    <Button Name="Heir" Access="Public" ToggleMode="false" StyleClasses="ButtonSquare" MinSize="150 20" Text="{Loc 'Назначить наследником'}"/>
                </GridContainer>
            </BoxContainer>
        </TabContainer>
    </BoxContainer>

    <BoxContainer Name="FactionMemberWindow" Orientation="Vertical" SeparationOverride="12" MinWidth="320" Access="Public" Visible="True" Margin="12">
        <!-- Заголовок с названием и иконкой -->
        <PanelContainer Name="FactionHeaderPanel" MinSize="0 70">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#202023" BorderColor="#353538" BorderThickness="1"/>
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Horizontal" Margin="12" SeparationOverride="16">
                <TextureRect Name="FactionIconMember" Access="Public" MinSize="48 48" Stretch="KeepAspectCentered" />
                <ui1:FactionLogoControl Name="FactionLogoMember" Access="Public" MinSize="48 48" />
                <BoxContainer Orientation="Vertical" VerticalAlignment="Center">
                     <RichTextLabel Name="FactionNameMember" Access="Public" />
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>

        <!-- Информационный блок -->
        <PanelContainer VerticalExpand="True">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1a1a1c" BorderColor="#252528" BorderThickness="1"/>
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="12">
                <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                    <Label Text="Лидер:" FontColorOverride="#a0a0a0" MinSize="80 0" />
                    <Label Name="FactionLeader" Access="Public" FontColorOverride="#e0e0e0" />
                </BoxContainer>
                
                <customControls:HSeparator StyleClasses="LowDivider" />

                <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                    <Label Text="Ваш ранг:" FontColorOverride="#a0a0a0" MinSize="80 0" />
                    <Label Name="FactionRank" Access="Public" FontColorOverride="#5fa3e0" />
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>

        <!-- Кнопки действий -->
        <BoxContainer Orientation="Vertical" SeparationOverride="10" Margin="0 4 0 0">
             <Button Name="LeaveButton" Access="Public" ToggleMode="false" StyleClasses="ButtonSquare"
                    MinSize="140 40"
                    Text="{Loc 'Выйти из фракции'}"
                    HorizontalAlignment="Center"/>
        </BoxContainer>
    </BoxContainer>
</ui1:FactionMenu>
